<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/background"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background"
        android:layout_marginLeft="@dimen/dimside"
        android:layout_marginRight="@dimen/dimside"
        >

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:paddingTop="@dimen/sizeTopTextPlay1"
        android:paddingBottom="@dimen/sizeBotTextPlay1"

        android:text="@string/playlist"
        android:fontWeight="@dimen/fontWeight"
        style="@style/MessageTextStyle"
        />
       </FrameLayout>


       <!-- Далее зона кнопок -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/background"

            android:layout_marginTop="@dimen/dimtopboxbutton"
            android:layout_marginBottom="@dimen/dimbottomboxbutton"
            >
            <!-- Кнопка Поиск -->
        <FrameLayout
            style="@style/ariaButtonMain"
            >

            <Button
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:icon="@drawable/search"
                android:text="@string/search"
                style="@style/Button_MainScreen"
                />

        </FrameLayout>

            <!-- Кнопка Медиатека-->
        <FrameLayout
            style="@style/ariaButtonMain"
            android:layout_marginBottom="@dimen/dimsidebutton"
            android:layout_marginTop="@dimen/dimsidebutton"
            >

            <Button
                android:id="@+id/lib"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:icon="@drawable/lib"
                android:text="@string/media"
                style="@style/Button_MainScreen"
                />

        </FrameLayout>

            <!-- Кнопка Настройки-->

        <FrameLayout
            style="@style/ariaButtonMain"
           >

            <Button
                android:id="@+id/settings"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:icon="@drawable/settings"
                android:text="@string/setting"
                style="@style/Button_MainScreen"
                />
        </FrameLayout>

        </LinearLayout>

    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>