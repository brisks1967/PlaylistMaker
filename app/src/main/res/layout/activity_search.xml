<?xml version="1.0" encoding="UTF-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchAct"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity"
    android:background="@color/backgroundSetting">

    <LinearLayout
        android:id="@+id/buttonContainer"
        style="@style/linearLayoutSearch"

        android:orientation="vertical"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        >
        <!-- Кнопка - Поиск-->
        <LinearLayout
            android:id="@+id/containerSearchBack"
            style="@style/linearLayoutSearch"

            android:orientation="horizontal"
            >

            <ImageView
                android:id="@+id/icon_dir2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="start"

                android:src="@drawable/dir3"
                app:tint="@color/iconSearchTop" />

            <TextView
                style="@style/textSearchTop"
                android:text="@string/searchText"
                android:textSize="@dimen/fontSet2"
                android:fontWeight="@dimen/fontWeight"
                android:textColor="@color/iconSearchTop"
                android:textAllCaps="false"
                android:fontFamily="@font/ys_text_medium"/>

        </LinearLayout>

        <!--  Поисковая строка-->
        <LinearLayout
            android:id="@+id/searchField2"
            style="@style/linearLayoutSearchField"
            android:orientation="horizontal"

            android:background="@drawable/circle_field"
            android:paddingBottom="8dp"
            android:paddingTop="8dp"
            >

            <ImageView
                android:id="@+id/icon_searchField"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:src="@drawable/search2"

                app:tint="@color/iconSearchBar"
                android:layout_gravity="center_vertical"
                android:gravity="start"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="10dp"
                />

            <EditText
                android:id="@+id/inputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/input_hint"
                android:fontWeight="@dimen/fontWeightSearchBar"
                android:fontFamily="@font/ys_display_regular"
                android:textSize="16sp"
                android:maxLength="25"
                android:maxLines="1"
                android:inputType="text"
                android:textColor="@color/iconSearchBar"
                android:textColorHint="@color/iconSearchBar"
                app:backgroundTint="@color/textOutlineSearch"
                android:textCursorDrawable="@drawable/cursor"
                />

            <ImageView
                android:id="@+id/clearIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:src="@drawable/clear"
                android:visibility="gone"
                app:tint="@color/iconSearchBar"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="10dp"
                />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>




