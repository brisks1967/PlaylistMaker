<?xml version="1.0" encoding="UTF-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/searchAct"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SearchActivity"
    android:background="@color/backgroundSetting">

    <LinearLayout
        android:id="@+id/buttonContainer"
        style="@style/linearLayoutSearch"

        android:orientation="vertical"
        android:layout_marginLeft="4dp"
        android:layout_marginRight="4dp"
        >
        <!-- Кнопка - Поиск-->
        <LinearLayout
            android:id="@+id/containerSearchBack"
            style="@style/linearLayoutSearch2"
            android:orientation="horizontal"
            >

            <ImageView
                android:id="@+id/icon_dir2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:gravity="start"

                android:src="@drawable/dir3"
                app:tint="@color/iconSearchTop" />

            <TextView
                style="@style/textSearchTop"
                android:text="@string/searchText"
                android:textSize="@dimen/fontSet2"
                android:fontWeight="@dimen/fontWeight"
                android:textColor="@color/iconSearchTop"
                android:textAllCaps="false"
                android:fontFamily="@font/ys_text_medium"/>
        </LinearLayout>

        <!--  Поисковая строка-->
        <LinearLayout
            android:id="@+id/searchField2"
            style="@style/linearLayoutSearchField"
            android:orientation="horizontal"
            android:background="@drawable/circle_field"
            android:layout_marginBottom="16dp"
            >

            <ImageView
                android:id="@+id/icon_searchField"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:src="@drawable/search2"

                app:tint="@color/iconSearchBar"
                android:layout_gravity="center_vertical"
                android:gravity="start"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="8dp"

                />

            <EditText
                android:id="@+id/inputEditText"

                style="@style/Widget.AppCompat.EditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="@font/ys_display_regular"
                android:fontWeight="@dimen/fontWeightSearchBar"
                android:hint="@string/input_hint"
                android:inputType="text"
                android:maxLength="25"
                android:maxLines="1"
                android:paddingTop="8.5dp"
                android:paddingBottom="8.5dp"
                android:textColor="@color/iconSearchBar"
                android:textColorHint="@color/iconSearchBar"
                android:textCursorDrawable="@drawable/cursor"
                android:textSize="16sp"

                app:backgroundTint="@color/textOutlineSearch"

                android:imeOptions="actionDone"
                android:singleLine="true"
                />

            <ImageView
                android:id="@+id/clearIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:src="@drawable/clear"
                android:visibility="gone"
                app:tint="@color/iconSearchBar"
                />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/track_item"
            tools:itemCount="4"
            />
        <!--  заглушка если ошибка поиска-->
        <LinearLayout
            android:id="@+id/emptyStateView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            >

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/nothing"
                android:layout_marginTop="102dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/noFind"
                style="@style/styleNoFind"
                android:layout_marginTop="16dp"
                />
        </LinearLayout>

        <!--  заглушка если ошибка соединения               -->
        <LinearLayout
            android:id="@+id/noInternet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            >

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/noint"
                android:layout_marginTop="102dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/noConnection"
                style="@style/styleNoConnection"

                android:layout_marginTop="16dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loadFail"
                style="@style/styleNoConnection"

                android:layout_marginTop="16dp"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
            />
            <ImageView
                android:id="@+id/resetInternet"
                android:layout_width="91dp"
                android:layout_height="36dp"
                android:src="@drawable/reset"
                android:layout_marginTop="24dp"
                />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


